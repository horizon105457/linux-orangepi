/*
 * Enable camera path 1 on Orange Pi CM5-CC.
 *
 * Path: CSI2 D-PHY0 → MIPI2-CSI2 → RKCIF → RKVISP1
 *       I2C1 for sensor control
 *
 * Dependencies: rk3588s-orangepi-cm5-cc-camera1.dtsi (included in main DTS)
 * Compatible sensors: OV13850 (0x10), OV13855 (0x36), etc. on I2C1
 */

/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target = <&csi2_dphy0_hw>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@1 {
		target = <&csi2_dphy0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@2 {
		target = <&mipi2_csi2>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@3 {
		target = <&rkcif_mipi_lvds2>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@4 {
		target = <&rkcif_mipi_lvds2_sditf>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@5 {
		target = <&rkisp0_vir1>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@6 {
		target = <&i2c1>;
		__overlay__ {
			status = "okay";

			vm149c-p1@c {
				status = "okay";
			};

			ov13850-1@10 {
				status = "okay";
			};

			dw9714-p1@c {
				status = "okay";
			};

			ov13855-1@36 {
				status = "okay";
			};
		};
	};

	fragment@7 {
		target = <&rkcif>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@8 {
		target = <&rkcif_mmu>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@9 {
		target = <&rkisp0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@10 {
		target = <&isp0_mmu>;
		__overlay__ {
			status = "okay";
		};
	};
};
